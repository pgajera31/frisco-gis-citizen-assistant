{
  "name": "@frisco-gis/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Model Context Protocol server exposing read-only City of Frisco public GIS tools.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "frisco-gis-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./vocabulary": "./dist/vocabulary.js",
    "./server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@turf/turf": "^7.4.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16"
  }
}