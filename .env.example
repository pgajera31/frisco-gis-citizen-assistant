# ---------------------------------------------------------------
# Frisco GIS Citizen Query Assistant - environment template
# Copy to `.env` (never commit `.env`).
# ---------------------------------------------------------------

# --- AI provider (Claude via the Anthropic API) -----------------
# Required for live AI mode. Without it the backend runs the
# clearly-labelled "offline planner" mode (rule-based routing that
# still calls the real MCP tools and live GIS services).
ANTHROPIC_API_KEY=
# Claude model and effort level used by the assistant.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Force a mode: "auto" (AI if key present), "ai", or "offline".
ASSISTANT_MODE=auto

# --- Backend ----------------------------------------------------
PORT=8787
# Comma-separated list of allowed browser origins (dev server).
CORS_ORIGINS=http://localhost:5173
# Requests per minute per IP for /api/chat.
RATE_LIMIT_PER_MINUTE=30
# Minutes before an idle conversation session is discarded.
SESSION_TTL_MINUTES=30

# --- MCP server -------------------------------------------------
# How the backend launches the MCP server (stdio transport).
# Defaults to running the built server with the current Node binary.
# MCP_SERVER_COMMAND=node
# MCP_SERVER_ARGS=packages/mcp-server/dist/index.js
# Per-request ArcGIS timeout (ms) and cache lifetime (seconds).
ARCGIS_TIMEOUT_MS=20000
GIS_CACHE_TTL_SECONDS=900
# Set to 0 to disable the Esri World Geocoder fallback
# (the City's own Address Points layer is always tried first).
ENABLE_ESRI_GEOCODER=1
